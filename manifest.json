{
  "manifest_version": 3,
  "name": "PinInfo",
  "version": "0.1.0",
  "description": "Pinterest research assistant: detects visible Pins and exposes publicly observable metadata without bypassing Pinterest controls.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.pinterest.com/*", "https://pinterest.com/*"],
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.pinterest.com/*", "https://pinterest.com/*"],
      "js": ["src/content/pinterest-detector.js", "src/content/pin-parser.js", "src/content/pin-overlay.js"],
      "css": ["src/content/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/popup/popup.html"
}
